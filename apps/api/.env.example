PGHOST=localhost
PGPORT=5432
PGUSER=nucleus_admin
PGPASSWORD=
PG_ADMIN_DATABASE=postgres
PG_DATABASE=bilheteplus
PG_TEST_DATABASE=bilheteplus_test
PORT=4100
TOKEN_SECRET=
WEBHOOK_SECRET=
# Limites por minuto e IP (0 = sem limite). Valores por omissão: login 20, registo 5, pedidos POST públicos 60.
LOGIN_RATE_LIMIT=20
REGISTER_RATE_LIMIT=5
PUBLIC_RATE_LIMIT=60
# E-mail (opcional). Sem SMTP_HOST as mensagens ficam só registadas na tabela notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Bilhete+ <no-reply@exemplo.mz>
PUBLIC_URL=
BASE_DOMAIN=
# Registo de empresas pelo público (desligado: as empresas são criadas pela administração em /staff)
SELF_REGISTRATION=false

# M-Pesa directo (Vodacom Moçambique, API C2B single-stage). Sem estas variáveis o M-Pesa fica desligado.
# Credenciais de sandbox/produção obtêm-se no portal de programadores M-Pesa (developer.mpesa.vm.co.mz).
MPESA_BASE_URL=
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ORIGIN=

# Entrada com Google (opcional). Crie as credenciais em console.cloud.google.com → APIs e serviços → Credenciais
# → ID de cliente OAuth (aplicação Web) e adicione o URI de redirecionamento: <PUBLIC_URL>/account/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
