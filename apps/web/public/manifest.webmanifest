{
  "id": "/",
  "name": "Bilhete+",
  "short_name": "Bilhete+",
  "description": "Eventos, bilhetes e a sua carteira no telemóvel.",
  "lang": "pt-MZ",
  "dir": "ltr",
  "start_url": "/app?source=pwa",
  "scope": "/",
  "scope_extensions": [{ "type": "origin", "origin": "https://*.bilhetemais.live" }],
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#0B0820",
  "theme_color": "#0B0820",
  "categories": [
    "entertainment",
    "lifestyle",
    "shopping"
  ],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Eventos",
      "short_name": "Eventos",
      "url": "/events",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Os meus bilhetes",
      "short_name": "Bilhetes",
      "url": "/account",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Perfil",
      "short_name": "Perfil",
      "url": "/account/profile",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://bilhetemais.live/manifest.webmanifest"
    }
  ],
  "prefer_related_applications": false
}